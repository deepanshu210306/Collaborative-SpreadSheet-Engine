{
  "name": "collaborative-spreadsheet-engine",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/client",
    "packages/engine",
    "packages/server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @spreadsheet/server\" \"npm run dev -w @spreadsheet/client\"",
    "build": "npm run build -w @spreadsheet/client",
    "start": "npm run start -w @spreadsheet/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
